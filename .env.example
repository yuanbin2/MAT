# 示例配置：复制成 .env 再填自己的值（.env 已被 .gitignore 忽略，不要提交）。
#
#   cp .env.example .env
#
# 只填三件套即可；留空 = 无 Key，服务进入 mock 降级模式（/api/health 报 llm_mode=mock）。

# 模型地址原样拼接 /chat/completions，不会补 /v1，也不会截路径（契约 §7.2）。
LLM_BASE_URL=https://api.deepseek.com
# 占位值，请替换成自己的 Key；不要提交、不要写进文档或日志。
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-chat

# 契约 §7.3：单次调用超时不小于 120 秒；/api/chat 整体在 180 秒内返回。
LLM_TIMEOUT=120
CHAT_BUDGET=150
